{
  "name": "smusic",
  "version": "1.0.0",
  "description": "Smusic",
  "main": "electron-main.js",
  "build": {
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:start": "wait-on tcp:5173 && electron .",
    "electron-dev": "concurrently \"vite\" \"npm run electron:start\"",
    "electron-build": "npm run build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "electron-is-dev": "^2.0.0",
    "naive-ui": "^2.34.4",
    "pinia": "^2.1.6",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.3.4",
    "concurrently": "^8.2.1",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.4",
    "vite": "^4.4.9",
    "wait-on": "^7.0.1"
  }
}
