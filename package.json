{
  "name": "smusic",
  "version": "1.2.0",
  "description": "Smusic",
  "main": "electron-main.js",
  "updateUrl": "https://smusic-release.pages.dev//version.json",
  "build": {
    "appId": "com.smusic.app",
    "productName": "Smusic",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 Audio File",
        "role": "Viewer",
        "icon": "assets/icon.ico"
      }
    ],
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js",
      "lib/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "services/api-enhanced",
        "to": "services/api-enhanced",
        "filter": [
          "**/*",
          "!.git/**",
          "!.github/**",
          "!.husky/**",
          "!test/**",
          "!examples/**",
          "!module_example/**",
          "!*.test.js",
          "!.editorconfig",
          "!.prettierrc",
          "!.travis.yml",
          "!eslint.config.js",
          "!renovate.json",
          "!pnpm-lock.yaml",
          "!Dockerfile",
          "!vercel.json"
        ]
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:start": "wait-on tcp:5173 && electron .",
    "electron-dev": "concurrently \"vite\" \"npm run electron:start\"",
    "electron-build": "npm run build && electron-builder",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "electron-is-dev": "^2.0.0",
    "mp3-duration": "^1.1.0",
    "naive-ui": "^2.34.4",
    "node-id3": "^0.2.9",
    "pinia": "^2.1.6",
    "pinia-plugin-persistedstate": "^3.2.3",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.3.4",
    "concurrently": "^8.2.1",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.4",
    "fast-check": "^4.4.0",
    "jest": "^30.2.0",
    "vite": "^4.4.9",
    "wait-on": "^7.0.1"
  }
}
